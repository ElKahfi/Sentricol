{
  "type": "object",
  "properties": {
    "workContext": { "type": "string", "minLength": 1, "maxLength": 600 },
    "records": {
      "type": "array", "minItems": 2, "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "detail": { "type": "string", "minLength": 1, "maxLength": 900 },
          "tag": { "type": "string", "enum": ["senderIdentity", "linkDestination", "attachmentSafety", "requestContext", "credentialProtection", "mfaSafety", "sensitiveDataHandling", "authorizationChecks"] },
          "relevant": { "type": "boolean" },
          "critical": { "type": "boolean" }
        },
        "required": ["label", "detail", "tag", "relevant", "critical"],
        "additionalProperties": false
      }
    },
    "explanation": { "type": "string", "minLength": 1, "maxLength": 1400 },
    "hints": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
  },
  "required": ["workContext", "records", "explanation", "hints"],
  "additionalProperties": false
}
