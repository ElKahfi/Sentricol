PROTOCOL_BASE_URL=http://127.0.0.1:3003
# Required for public HTTPS; comma-separated exact Google mailbox addresses.
PROTOCOL_ALLOWED_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional overrides (model defaults come from ../ai-harness/.env.local).
# GMAIL_PYTHON=.venv/bin/python
# SENTRI_PYTHON=python3
# OLLAMA_HOST=http://127.0.0.1:11434
# SENTRI_MODEL=huihui_ai/qwen3-abliterated:latest
# SENTRI_HARNESS_PATH=/absolute/path/to/ai-harness
# Optional server-side sender approvals (per connected mailbox).
# PROTOCOL_TRUSTED_SENDERS_PATH=config/trusted-senders.local.json
# Required for Gmail sign-in: identical server-held secret in Deployment and Protocol.
DEPLOYMENT_URL=http://127.0.0.1:3002
PROTOCOL_DEPLOYMENT_SECRET=
