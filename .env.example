# Copy to .env; never commit the filled-in file.
# Copy the URL from Neon, retaining its TLS query parameters.
DATABASE_URL=
# Generate two separate values with: openssl rand -hex 32
DEPLOYMENT_SESSION_SECRET=
DISPATCH_SESSION_SECRET=
DEPLOYMENT_ORIGIN=http://localhost:3002
DISPATCH_ORIGIN=http://localhost:3000
# Qwen 3.0: set the exact installed Ollama tag; size/quantization are not yet confirmed.
SENTRI_MODEL=
# Pin a tested tag or digest before a public production rollout.
OLLAMA_IMAGE=ollama/ollama:latest
# Optional until testing Gmail; copy these privately from your Google project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Coolify public Protocol (manual compose.yaml retains its loopback settings).
PROTOCOL_BASE_URL=
PROTOCOL_ALLOWED_EMAILS=
# Protocol verifies employee access against this Deployment HTTPS origin.
# For separate local development processes use http://127.0.0.1:3002.
DEPLOYMENT_URL=
# Generate a third, independent secret (at least 32 characters); share only
# between Deployment and Protocol. Keep stable while the outbox has pending alerts.
PROTOCOL_DEPLOYMENT_SECRET=
# Optional local Dispatch demo tools; never enable on a public development server.
# DISPATCH_LOCAL_ADMIN_TOOLS=false
