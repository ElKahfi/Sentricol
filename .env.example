# Copy to .env; never commit the filled-in file.
# Copy the URL from Neon, retaining its TLS query parameters.
DATABASE_URL=
# Generate two separate values with: openssl rand -hex 32
DEPLOYMENT_SESSION_SECRET=
DISPATCH_SESSION_SECRET=
DEPLOYMENT_ORIGIN=http://localhost:3002
# Qwen 3.0: set the exact installed Ollama tag; size/quantization are not yet confirmed.
SENTRI_MODEL=
# Pin a tested tag or digest before a public production rollout.
OLLAMA_IMAGE=ollama/ollama:latest
# Optional until testing Gmail; copy these privately from your Google project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
